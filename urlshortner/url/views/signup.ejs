<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f7fb" />
    <title>Create account | Linklet</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-page">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Linklet home">
        <span class="brand-mark" aria-hidden="true">↗</span>
        <span>linklet</span>
      </a>
    </header>
    <main class="auth-shell">
      <section class="auth-card">
        <div class="auth-icon" aria-hidden="true">✦</div>
        <p class="eyebrow">START SHARING BETTER</p>
        <h1>Create your account</h1>
        <p class="auth-description">Your links deserve a simpler home.</p>
        <% if (locals.error) { %>
        <div class="notice error-notice" role="alert"><%= error %></div>
        <% } %>
        <form class="auth-form" action="/user" method="post">
          <label for="name">Full name</label>
          <input id="name" type="text" required name="name" autocomplete="name" placeholder="Your name" value="<%= locals.name || '' %>" />
          <label for="email">Email address</label>
          <input id="email" type="email" required name="email" autocomplete="email" placeholder="you@example.com" value="<%= locals.email || '' %>" />
          <label for="password">Password</label>
          <input id="password" type="password" required name="password" autocomplete="new-password" placeholder="Create a password" />
          <button class="button button-primary button-wide" type="submit">Create account <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
      </section>
    </main>
  </body>
</html>
